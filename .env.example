# Copy to .env and fill in. Expo inlines EXPO_PUBLIC_* at build time, so restart `expo start` after editing.

# Colyseus server. Real phone: ws://<PC LAN IP>:2567   Android emulator: ws://10.0.2.2:2567
# After you deploy: wss://<your-app>.fly.dev  (use wss:// for https hosts)
EXPO_PUBLIC_SERVER_URL=ws://192.168.0.10:2567

# Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
# Leave empty to run in local-guest mode (needs a dev-mode server, i.e. FIREBASE_PROJECT_ID unset).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
